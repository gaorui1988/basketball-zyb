/** 组一波 - 全局样式 */

page {
  --color-surface: #f5f0eb;
  --color-surface-container: #ffffff;
  --color-surface-container-low: #f0ebe5;
  --color-surface-container-high: #e8e3dd;
  --color-surface-container-highest: #ddd8d2;
  --color-on-surface: #1a1a1a;
  --color-primary: #ff6b00;
  --color-primary-container: #ff6b00;
  --color-secondary: #666666;
  --color-secondary-container: #f0ebe5;
  --color-tertiary-container: #333333;
  --color-error: #dc3545;
  --color-on-secondary-container: #1a1a1a;

  background-color: var(--color-surface);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--color-on-surface);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slideLeft {
  from { opacity: 0; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideRight {
  from { opacity: 0; transform: translateX(20rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.anim-fade { animation: fadeIn 0.3s ease-out; }
.anim-slide-left { animation: slideLeft 0.3s ease-out; }
.anim-slide-right { animation: slideRight 0.3s ease-out; }
.anim-scale { animation: scaleIn 0.3s ease-out; }

/* 安全区 */
.safe-bottom {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.safe-top {
  padding-top: calc(20rpx + env(safe-area-inset-top));
}
