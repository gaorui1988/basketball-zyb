.lb-page { min-height: 100vh; background: var(--color-surface); padding-bottom: 160rpx; }

.lb-header {
  display: flex; justify-content: space-between; align-items: center; padding: 20rpx 32rpx 16rpx;
  position: sticky; top: 0; z-index: 50; background: rgba(245,240,235,0.95);
  border-bottom: 1px solid rgba(0,0,0,0.05);
}
.lb-header-left { display: flex; align-items: center; gap: 16rpx; }
.lb-avatar { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; border: 2px solid var(--color-primary-container); }
.lb-avatar-img { width: 100%; height: 100%; }
.lb-title { font-size: 32rpx; font-weight: 700; color: var(--color-primary); letter-spacing: -0.02em; }
.lb-points { display: flex; align-items: center; gap: 4rpx; background: var(--color-surface-container-high); padding: 8rpx 14rpx; border-radius: 12rpx; border: 1px solid rgba(0,0,0,0.05); }
.lb-star { font-size: 20rpx; }
.lb-points-text { font-size: 14px; font-weight: 700; }

/* Podium */
.lb-podium {
  display: flex; justify-content: center; align-items: flex-end; gap: 12rpx;
  padding: 64rpx 32rpx 0; margin-bottom: 48rpx;
}
.podium-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.podium-item.first { transform: translateY(-16rpx); z-index: 2; }
.podium-trophy { font-size: 42rpx; margin-bottom: 10rpx; }

.podium-avatar { border-radius: 50%; overflow: hidden; margin-bottom: 10rpx; }
.podium-avatar.gold { width: 80px; height: 80px; border: 4px solid var(--color-primary-container); box-shadow: 0 0 30rpx rgba(255,107,0,0.25); }
.podium-avatar.silver { width: 64px; height: 64px; border: 4px solid #ccc; }
.podium-avatar.bronze { width: 64px; height: 64px; border: 4px solid rgba(180,83,9,0.4); }
.podium-avatar-img { width: 100%; height: 100%; }

.podium-rank { color: white; padding: 4rpx 10rpx; border-radius: 20rpx; font-size: 16rpx; font-weight: 700; margin-bottom: 6rpx; }
.gold-bg { background: var(--color-primary-container); font-size: 20rpx; padding: 4rpx 14rpx; }
.silver-bg { background: #9ca3af; }
.bronze-bg { background: #b45309; }

.podium-name { font-size: 16px; font-weight: 700; text-align: center; overflow: hidden; text-overflow: ellipsis; width: 100%; white-space: nowrap; }
.podium-name.gold-name { font-size: 18px; color: var(--color-primary); }
.podium-pts { font-size: 14px; font-weight: 700; color: var(--color-primary-container); text-transform: uppercase; }
.podium-pts.gold-pts { color: var(--color-primary); }

/* List */
.lb-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 12rpx; }
.lb-item { display: flex; align-items: center; padding: 16rpx; background: var(--color-surface-container); border-radius: 12rpx; border: 1px solid rgba(0,0,0,0.05); }
.lb-item.me { background: rgba(255,107,0,0.06); border-color: rgba(255,107,0,0.25); }
.lb-rank { font-size: 34rpx; width: 40rpx; color: rgba(102,102,102,0.45); font-weight: 700; }
.lb-item.me .lb-rank { color: var(--color-primary-container); }
.lb-avatar-sm { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; margin-right: 16rpx; }
.lb-avatar-sm.hl { border: 2px solid var(--color-primary-container); }
.lb-avatar-sm-img { width: 100%; height: 100%; }
.lb-info { flex: 1; }
.lb-name-row { display: flex; align-items: center; gap: 6rpx; }
.lb-name { font-size: 18px; font-weight: 700; }
.lb-item.me .lb-name { color: var(--color-primary); }
.lb-me-badge { background: var(--color-primary-container); padding: 2rpx 6rpx; border-radius: 4rpx; }
.lb-me-badge text { color: white; font-size: 12px; font-weight: 700; text-transform: uppercase; }
.lb-mvp { font-size: 14px; color: var(--color-secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-top: 2rpx; }
.lb-pts-wrap { text-align: right; }
.lb-pts-num { font-size: 28rpx; line-height: 1; color: var(--color-primary-container); font-weight: 700; }
.lb-item.me .lb-pts-num { color: var(--color-primary); }
.lb-pts-label { font-size: 12px; font-weight: 700; color: var(--color-secondary); text-transform: uppercase; letter-spacing: 0.08em; display: block; }
