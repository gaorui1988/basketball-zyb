.activity-card {
  background: var(--color-surface-container);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.05);
  position: relative;
  animation: fadeIn 0.3s ease-out;
}
.activity-card-inner { padding: 20rpx; }
.activity-left-bar {
  position: absolute; top: 0; left: 0; width: 4px; height: 100%;
  background: transparent;
}
.activity-left-bar.active { background: var(--color-primary-container); }

.activity-top {
  display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx;
}
.activity-title { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 6rpx; line-height: 1.2; }
.activity-location { display: flex; align-items: center; gap: 4rpx; }
.activity-location-icon { font-size: 20rpx; }
.activity-location-text { font-size: 14px; color: var(--color-secondary); }

.activity-badge {
  padding: 6rpx 12rpx; border-radius: 8rpx; font-size: 16rpx; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.02em; border: 1px solid;
}
.badge-registering { background: rgba(255,107,0,0.12); color: var(--color-primary-container); border-color: rgba(255,107,0,0.25); }
.badge-upcoming { background: rgba(102,102,102,0.08); color: var(--color-secondary); border-color: rgba(0,0,0,0.05); }
.badge-ended { background: rgba(0,0,0,0.06); color: var(--color-secondary); border-color: rgba(0,0,0,0.05); }

.match-result {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--color-surface-container-low); padding: 16rpx; border-radius: 12rpx;
  border: 1px solid rgba(0,0,0,0.05); margin-bottom: 8rpx;
}
.match-result-inner { display: flex; align-items: center; gap: 12rpx; }
.match-result-avatar { width: 40px; height: 40px; border-radius: 50%; border: 2px solid white; }
.match-result-score { font-size: 40rpx; color: var(--color-primary-container); letter-spacing: 0.02em; font-weight: 700; }
.match-result-label { text-align: right; font-size: 14px; font-weight: 700; color: var(--color-secondary); text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.3; }

.activity-details { display: flex; gap: 8rpx; margin-bottom: 16rpx; }
.detail-item {
  flex: 1; display: flex; align-items: center; gap: 8rpx;
  background: var(--color-surface-container-low); padding: 10rpx; border-radius: 10rpx;
}
.detail-icon { font-size: 24rpx; }
.detail-text-wrap { display: flex; flex-direction: column; }
.detail-label { font-size: 14px; font-weight: 700; color: var(--color-secondary); text-transform: uppercase; letter-spacing: 0.06em; }
.detail-value { font-size: 20rpx; font-weight: 700; }

.activity-footer { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.player-avatars { display: flex; align-items: center; }
.player-avatar {
  width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--color-surface-container); margin-left: -8rpx;
}
.player-avatar:first-child { margin-left: 0; }
.player-avatar-more {
  width: 32px; height: 32px; border-radius: 50%; background: var(--color-surface-container-highest);
  border: 2px solid var(--color-surface-container); margin-left: -8rpx;
  display: flex; align-items: center; justify-content: center;
}
.player-avatar-more text { font-size: 12px; font-weight: 700; color: var(--color-secondary); }

.player-count { display: flex; align-items: center; gap: 2rpx; }
.player-count-num { font-size: 34rpx; color: var(--color-primary-container); line-height: 1; font-weight: 700; }
.player-count-total { font-size: 14px; color: var(--color-secondary); }

.progress-bar { width: 100%; height: 6px; background: var(--color-surface-container-highest); border-radius: 4px; overflow: hidden; }
.progress-fill {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-container));
  transition: width 0.5s;
}
.progress-fill.fill-full { background: var(--color-primary-container); }
