.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 20rpx 32rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(245, 240, 235, 0.95);
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  overflow: hidden;
  background: #ddd8d2;
  border: 1px solid rgba(0, 0, 0, 0.05);
}
.header-avatar-img { width: 100%; height: 100%; }
.header-title {
  font-size: 36rpx;
  letter-spacing: -0.04em;
  color: var(--color-primary);
  font-weight: 800;
  text-transform: uppercase;
}
.header-points {
  padding: 8rpx 14rpx;
  background: var(--color-surface-container-high);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border: 1px solid rgba(0, 0, 0, 0.05);
}
.header-points-icon { font-size: 22rpx; }
.header-points-text { font-size: 14px; font-weight: 700; color: var(--color-primary-container); }
